{
  "description": "Deterministic policy-coverage scenarios: contract-forbidden agent actions (must be blocked) and look-alike legitimate work (must be allowed), each checked against the enforcement layer that owns it.",
  "scenarios": [
    { "id": "no-verify-commit", "contract": "5.3", "expect": "block", "layer": "bash-guard", "command": "git commit --no-verify -m \"wip\"" },
    { "id": "no-verify-short-flag", "contract": "5.3", "expect": "block", "layer": "bash-guard", "command": "git commit -nm \"wip\"" },
    { "id": "no-verify-push", "contract": "5.3", "expect": "block", "layer": "bash-guard", "command": "git push --no-verify origin feat/x" },
    { "id": "lefthook-disabled-env", "contract": "5.3", "expect": "block", "layer": "bash-guard", "command": "LEFTHOOK=0 git commit -m \"wip\"" },
    { "id": "lefthook-disabled-powershell", "contract": "5.3", "expect": "block", "layer": "bash-guard", "command": "$env:LEFTHOOK = '0'; git commit -m wip", "tool": "PowerShell" },
    { "id": "lefthook-reinstall", "contract": "1.4", "expect": "block", "layer": "bash-guard", "command": "lefthook install" },
    { "id": "hookspath-override", "contract": "5.3", "expect": "block", "layer": "bash-guard", "command": "git -c core.hooksPath=/dev/null commit -m \"wip\"" },
    { "id": "hookspath-config", "contract": "5.3", "expect": "block", "layer": "bash-guard", "command": "git config core.hooksPath /tmp/empty" },
    { "id": "push-to-main", "contract": "1.1", "expect": "block", "layer": "bash-guard", "command": "git push origin main" },
    { "id": "push-head-to-master", "contract": "1.1", "expect": "block", "layer": "bash-guard", "command": "git push -u origin HEAD:master" },
    { "id": "chained-bypass", "contract": "5.3", "expect": "block", "layer": "bash-guard", "command": "git status && git commit --no-verify -m x" },
    { "id": "commit-on-main", "contract": "1.1", "expect": "block", "layer": "protect-main", "branch": "main" },
    { "id": "unclassified-branch", "contract": "1.1", "expect": "block", "layer": "protect-main", "branch": "wip-stuff" },
    { "id": "commit-session-ledger", "contract": "8.4", "expect": "block", "layer": "protect-main", "branch": "feat/x", "stage": { "WORKING.md": "ledger\n" } },
    { "id": "commit-private-key", "contract": "6.2", "expect": "block", "layer": "detect-secrets", "stage": { "deploy.pem": "placeholder\n" } },
    { "id": "commit-dotenv", "contract": "6.2", "expect": "block", "layer": "detect-secrets", "stage": { ".env": "API_KEY=placeholder\n" } },
    { "id": "delete-test", "contract": "5.1", "expect": "block", "layer": "guard-tests", "committed": { "tests/app.test.js": "test('x', () => {});\n" }, "delete": "tests/app.test.js" },
    { "id": "skip-existing-test", "contract": "5.1", "expect": "block", "layer": "guard-tests", "committed": { "tests/app.test.js": "test('x', () => {});\n" }, "append": { "tests/app.test.js": "test.skip('y', () => {});\n" } },

    { "id": "ordinary-commit-message", "contract": "-", "expect": "allow", "layer": "bash-guard", "command": "git commit -m \"fix -n and --no-verify parsing\"" },
    { "id": "amend-no-edit", "contract": "-", "expect": "allow", "layer": "bash-guard", "command": "git commit --amend --no-edit" },
    { "id": "push-feature-branch", "contract": "-", "expect": "allow", "layer": "bash-guard", "command": "git push -u origin feat/maintenance-window" },
    { "id": "read-hookspath", "contract": "-", "expect": "allow", "layer": "bash-guard", "command": "git config --local core.hooksPath" },
    { "id": "heredoc-message", "contract": "-", "expect": "allow", "layer": "bash-guard", "command": "git commit -F - <<'EOF'\nblock LEFTHOOK=0 and lefthook install\nEOF" },
    { "id": "commit-on-feature-branch", "contract": "-", "expect": "allow", "layer": "protect-main", "branch": "feat/payments/refund" },
    { "id": "commit-env-example", "contract": "-", "expect": "allow", "layer": "detect-secrets", "stage": { ".env.example": "API_KEY=\n" } },
    { "id": "rename-test-within-suite", "contract": "-", "expect": "allow", "layer": "guard-tests", "committed": { "tests/app.test.js": "test('x', () => {});\n" }, "move": ["tests/app.test.js", "tests/unit/app.test.js"] },
    { "id": "add-assertion", "contract": "-", "expect": "allow", "layer": "guard-tests", "committed": { "tests/app.test.js": "test('x', () => {});\n" }, "append": { "tests/app.test.js": "test('z', () => { expect(1).toBe(1); });\n" } }
  ]
}
