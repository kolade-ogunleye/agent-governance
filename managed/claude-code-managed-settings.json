{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(!.env.sample)",
      "Read(!.env.template)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.p12)",
      "Read(*.pfx)",
      "Read(*.keystore)",
      "Read(*.jks)",
      "Read(id_rsa)",
      "Read(id_dsa)",
      "Read(id_ecdsa)",
      "Read(id_ed25519)",
      "Read(credentials.json)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Edit(!.env.sample)",
      "Edit(!.env.template)",
      "Edit(*.pem)",
      "Edit(*.key)",
      "Edit(*.p12)",
      "Edit(*.pfx)",
      "Edit(*.keystore)",
      "Edit(*.jks)",
      "Edit(id_rsa)",
      "Edit(id_dsa)",
      "Edit(id_ecdsa)",
      "Edit(id_ed25519)",
      "Edit(credentials.json)",
      "Edit(.git/hooks/**)",
      "Edit(.githooks/**)",
      "Edit(.husky/**)",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/.github/copilot-instructions.md)",
      "Edit(/.github/workflows/agent-governance.yml)",
      "Edit(/.agent-governance.lock)",
      "Edit(/.agents/rules/**)",
      "Edit(/.claude/rules/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.codex/config.toml)",
      "Edit(/.gemini/settings.json)",
      "Edit(/lefthook.yml)",
      "Edit(/scripts/guardrails/**)",
      "Bash(*--no-verif*)",
      "Bash(*LEFTHOOK=*)",
      "Bash(*LEFTHOOK_EXCLUDE=*)",
      "Bash(*lefthook install*)",
      "Bash(*lefthook uninstall*)",
      "Bash(*core.hooksPath=*)",
      "Bash(git config *core.hooksPath *)",
      "Bash(git config *unset* core.hooksPath*)",
      "Bash(*GIT_CONFIG_COUNT=*)",
      "Bash(*GIT_CONFIG_PARAMETERS=*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push * master)",
      "Bash(git push * master *)",
      "Bash(git push *:master)",
      "Bash(git push *:master *)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push *refs/heads/master*)",
      "Bash(*>*.git/hooks/*)",
      "Bash(rm *.git/hooks/*)",
      "Bash(mv *.git/hooks/*)",
      "Bash(cp *.git/hooks/*)",
      "Bash(chmod *.git/hooks/*)",
      "Bash(*core.hookspath=*)",
      "Bash(*GIT_CONFIG_GLOBAL=*)",
      "Bash(*GIT_CONFIG_SYSTEM=*)",
      "Bash(tee *.git/hooks/*)",
      "Bash(cd *.git/hooks*)",
      "Bash(*>*.githooks/*)",
      "Bash(rm *.githooks*)",
      "Bash(mv *.githooks*)",
      "Bash(cp *.githooks*)",
      "Bash(chmod *.githooks*)",
      "PowerShell(*--no-verif*)",
      "PowerShell(*LEFTHOOK=*)",
      "PowerShell(*LEFTHOOK_EXCLUDE=*)",
      "PowerShell(*lefthook install*)",
      "PowerShell(*lefthook uninstall*)",
      "PowerShell(*core.hooksPath=*)",
      "PowerShell(git config *core.hooksPath *)",
      "PowerShell(git config *unset* core.hooksPath*)",
      "PowerShell(*GIT_CONFIG_COUNT=*)",
      "PowerShell(*GIT_CONFIG_PARAMETERS=*)",
      "PowerShell(git push * main)",
      "PowerShell(git push * main *)",
      "PowerShell(git push *:main)",
      "PowerShell(git push *:main *)",
      "PowerShell(git push * master)",
      "PowerShell(git push * master *)",
      "PowerShell(git push *:master)",
      "PowerShell(git push *:master *)",
      "PowerShell(git push *refs/heads/main*)",
      "PowerShell(git push *refs/heads/master*)",
      "PowerShell(*>*.git/hooks/*)",
      "PowerShell(rm *.git/hooks/*)",
      "PowerShell(mv *.git/hooks/*)",
      "PowerShell(cp *.git/hooks/*)",
      "PowerShell(chmod *.git/hooks/*)",
      "PowerShell(*core.hookspath=*)",
      "PowerShell(*GIT_CONFIG_GLOBAL=*)",
      "PowerShell(*GIT_CONFIG_SYSTEM=*)",
      "PowerShell(tee *.git/hooks/*)",
      "PowerShell(cd *.git/hooks*)",
      "PowerShell(*>*.githooks/*)",
      "PowerShell(rm *.githooks*)",
      "PowerShell(mv *.githooks*)",
      "PowerShell(cp *.githooks*)",
      "PowerShell(chmod *.githooks*)",
      "PowerShell(*env:LEFTHOOK*)",
      "PowerShell(*env:GIT_CONFIG_*)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.config/gh",
        "~/.git-credentials",
        "./**/.env",
        "./**/*.pem",
        "./**/*.key"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "crates.io",
        "static.crates.io",
        "index.crates.io",
        "proxy.golang.org",
        "sum.golang.org",
        "repo.packagist.org",
        "packagist.org",
        "www.powershellgallery.com",
        "api.nuget.org"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.aws/credentials",
          "mode": "deny"
        },
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.gnupg",
          "mode": "deny"
        },
        {
          "path": "~/.git-credentials",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "mode": "deny"
        },
        {
          "name": "AWS_SESSION_TOKEN",
          "mode": "deny"
        },
        {
          "name": "AZURE_CLIENT_SECRET",
          "mode": "deny"
        }
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-File",
              "__HUB_GUARD__"
            ]
          }
        ]
      }
    ]
  }
}
